# Database (Supabase PostgreSQL Connection Pooler recommended for Vercel Serverless)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require"

# NextAuth v5 Authentication
AUTH_SECRET="generate-with-npx-auth-secret"
AUTH_TRUST_HOST="true"

# Initial Admin Account (used by: npm run admin:create)
ADMIN_EMAIL="admin@techsolutionsbd.com"
ADMIN_PASSWORD="CHANGE_ME_TO_A_STRONG_PASSWORD"
ADMIN_NAME="Store Owner"

# Supabase (Customer Auth & Real-Time Storage)
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Cloudinary (Optional image hosting)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# SMTP Email Notifications (Order confirmation & customer receipts)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="orders@yourdomain.com"
SMTP_PASS="your-app-password"
SMTP_FROM="Tech Solutions BD <orders@yourdomain.com>"
SMTP_ALLOW_SELF_SIGNED=true

# Telegram Bot Instant Order Alerts
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_CHAT_ID=""

# Google OAuth (Optional Social Login)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Mobile Banking Numbers (Displayed on Checkout, Payment Gateway & Policy pages)
NEXT_PUBLIC_BKASH_NUMBER="01641699879"
NEXT_PUBLIC_NAGAD_NUMBER="01641699879"
NEXT_PUBLIC_ROCKET_NUMBER="015189028225"
NEXT_PUBLIC_UPAY_NUMBER="01641699879"

# Google Analytics 4 Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-RYWMMMS7FB"
