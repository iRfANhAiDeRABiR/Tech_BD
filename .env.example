DATABASE_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require"
# Optional: use the Supabase pooler connection if you need it for production runtime.
# DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require"
AUTH_SECRET="generate-with-npx-auth-secret"
AUTH_TRUST_HOST="true"

# Used by: npm run admin:create
# IMPORTANT: Use strong, unique credentials for production. Do not commit real passwords.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="CHANGE_ME_TO_A_STRONG_PASSWORD"
ADMIN_NAME="Store Owner"

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# SMTP settings for automated checkout order confirmation emails.
# For Gmail, use SMTP_HOST="smtp.gmail.com", SMTP_PORT="465", SMTP_SECURE="true",
# SMTP_USER as your Gmail address, and SMTP_PASS as an app password.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="name <orders@example.com>"

# Payment Numbers (displayed on Checkout / Payment Gateway / Policy pages)
NEXT_PUBLIC_BKASH_NUMBER=""
NEXT_PUBLIC_NAGAD_NUMBER=""
NEXT_PUBLIC_ROCKET_NUMBER=""
NEXT_PUBLIC_UPAY_NUMBER=""
